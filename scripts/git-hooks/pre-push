#!/usr/bin/env bash
# Pre-push hook: block version tag pushes unless the dead-code scan and both
# the mocked and live test suites pass.
#
# The mocked suite (default `pytest` run) covers pytest-ruff lint across
# parkour_mcp/, tests/, and scripts/, plus the offline unit suite.  It's
# the exact step CI runs on tag push — skipping it locally let a ruff E402
# regression in scripts/regenerate_readme_examples.py escape to v1.1.1.
#
# The vulture scan runs here because it runs nowhere else: CI's tag-push job
# is `uv run pytest` and nothing more, so between vulture's adoption and
# v2.0.0 its findings accumulated without ever failing a gate.  It is the
# cheapest of the three (no network, sub-second), so it goes first.
#
# The docs-drift scan is the same shape of problem: `just docs-drift` existed
# but nothing invoked it, so a doc anchored to code that moved in a July lint
# sweep sat stale until someone ran the recipe by hand.  `just tag` now runs it
# before creating a tag; this hook repeats it for the path that skips `just
# tag` and tags by hand.  Also no network, ~1 s.
#
# Live tests hit real endpoints, so they can't run unattended in CI without
# credentials.  Running them at tag-push time is our stand-in: format drift
# that would otherwise escape to a release gets caught at the last moment.
#
# Only engages when a refs/tags/v* ref is being pushed.  Regular branch pushes
# are unaffected and pay no latency cost.
#
# Git passes refs on stdin in the format:
#     <local ref> <local sha1> <remote ref> <remote sha1>
# one line per ref being pushed.

set -euo pipefail

pushing_version_tag=0
tag_names=()

while read -r _local_ref _local_sha remote_ref _remote_sha; do
    case "$remote_ref" in
        refs/tags/v*)
            pushing_version_tag=1
            tag_names+=("${remote_ref#refs/tags/}")
            ;;
    esac
done

if [[ "$pushing_version_tag" -eq 0 ]]; then
    exit 0
fi

echo "pre-push: version tag(s) detected: ${tag_names[*]}"
echo

repo_root="$(git rev-parse --show-toplevel)"

# Doc-drift scan runs first — ~1 s, no network, and it is the gate most
# likely to be stale because docs rot silently while tests stay green.
echo "pre-push: checking docs against code (cog, drift anchors, manifest tools)..."
if ! just --justfile "$repo_root/justfile" --working-directory "$repo_root" docs-drift; then
    echo
    echo "pre-push: DOC-DRIFT CHECK FAILED — refusing to push version tag"
    echo "pre-push:"
    echo "pre-push: A doc describes code that has since moved.  Read the doc"
    echo "pre-push: section and the code side by side, update the prose if it"
    echo "pre-push: is wrong, then restamp with:"
    echo "pre-push:     drift link <doc-path> --doc-is-still-accurate"
    echo "pre-push: For a cog mismatch, run 'just docs-drift-fix' instead."
    exit 1
fi

echo
# Dead-code scan runs next — sub-second, and the only place it runs at all.
echo "pre-push: running vulture dead-code scan..."
if ! uv run --directory "$repo_root" vulture parkour_mcp/ .vulture_whitelist.py; then
    echo
    echo "pre-push: DEAD-CODE SCAN FAILED — refusing to push version tag"
    echo "pre-push:"
    echo "pre-push: Fix each finding at the source.  Only add a name to"
    echo "pre-push: .vulture_whitelist.py when vulture genuinely cannot see"
    echo "pre-push: the use (decorator registration, entry point, compiled"
    echo "pre-push: extension, or test-only hook), with a comment saying which."
    exit 1
fi

echo
# Mocked suite runs second — fast (~15 s), catches ruff/format regressions
# that CI's default `uv run pytest` would also fail on.
echo "pre-push: running mocked test suite (incl. ruff lint)..."
if ! uv run --directory "$repo_root" pytest --tb=short; then
    echo
    echo "pre-push: MOCKED TESTS FAILED — refusing to push version tag"
    echo "pre-push:"
    echo "pre-push: These are the same tests CI runs on tag push.  Fix them"
    echo "pre-push: locally instead of bypassing the hook — a tag that fails"
    echo "pre-push: this step produces a broken release with no PyPI artifact"
    echo "pre-push: and no GitHub Release."
    exit 1
fi

echo
echo "pre-push: mocked suite passed — running live test suite..."
echo
if uv run --directory "$repo_root" pytest -m live --tb=short; then
    echo
    echo "pre-push: live tests passed — tag push allowed"
    exit 0
fi

echo
echo "pre-push: LIVE TESTS FAILED — refusing to push version tag"
echo "pre-push:"
echo "pre-push: If the failure is caused by an external endpoint outage"
echo "pre-push: (not a format regression in our code), you can bypass with:"
echo "pre-push:     git push --no-verify"
echo "pre-push: Verify the failure is upstream before using that escape hatch."
exit 1
